{
    "name": "@flower-digital/exoapi-sdk",
    "version": "1.1.3",
    "description": "JavaScript/TypeScript SDK for ExoAPI",
    "main": "dist/index.js",
    "typings": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flower-digital/exoapi-sdk.git"
    },
    "keywords": [
        "barcode generator",
        "content moderation",
        "html renderer",
        "reverse geocoding",
        "unit converter"
    ],
    "license": "MIT",
    "scripts": {
        "prepare": "npm run build",
        "build": "tsc --declaration",
        "generate-code": "curl http://localhost:3600/products/sdk/typescript > src/index.ts",
        "test": "exit 0"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": true
    },
    "devDependencies": {
        "@types/node": "20.12.7",
        "ts-node": "10.9.2",
        "typescript": "5.4.3"
    },
    "dependencies": {
        "cross-fetch": "4.0.0"
    }
}
